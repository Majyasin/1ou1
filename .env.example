# =============================================================================
# CODEFORGE AI - COMPREHENSIVE ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Get API keys from respective service providers
# =============================================================================

# -----------------------------------------------------------------------------
# AI & CODE GENERATION (REQUIRED)
# -----------------------------------------------------------------------------
# Anthropic Claude API - For AI code generation
# Get your API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# OpenAI API - Alternative AI provider (Optional)
OPENAI_API_KEY=sk-xxx


# -----------------------------------------------------------------------------
# AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Clerk - User authentication and management
# Get your keys: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk URLs (customize or use defaults)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/editor
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/editor


# -----------------------------------------------------------------------------
# DATABASE (REQUIRED FOR PRODUCTION)
# -----------------------------------------------------------------------------
# Supabase - PostgreSQL database with real-time features
# Get your keys: https://supabase.com/dashboard/
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Direct PostgreSQL Connection (Alternative)
DATABASE_URL=postgresql://user:password@host:5432/database


# -----------------------------------------------------------------------------
# PAYMENTS (OPTIONAL)
# -----------------------------------------------------------------------------
# Stripe - Payment processing for subscriptions/billing
# Get your keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Product IDs (create in Stripe Dashboard)
STRIPE_PRICE_ID_BASIC=price_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx


# -----------------------------------------------------------------------------
# EMAIL (OPTIONAL)
# -----------------------------------------------------------------------------
# Resend - Transactional email service
# Get your API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Email settings
EMAIL_FROM=noreply@codeforge.ai
EMAIL_FROM_NAME=CodeForge AI


# -----------------------------------------------------------------------------
# CLOUD STORAGE (OPTIONAL)
# -----------------------------------------------------------------------------
# AWS S3 - File storage and assets
# Get credentials: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=AKIAxxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=codeforge-assets

# Cloudflare R2 - S3-compatible storage (Alternative)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=codeforge


# -----------------------------------------------------------------------------
# DEPLOYMENT & HOSTING
# -----------------------------------------------------------------------------
# Vercel - Primary deployment platform
# Get token: https://vercel.com/account/tokens
VERCEL_TOKEN=xxx
VERCEL_ORG_ID=xxx
VERCEL_PROJECT_ID=xxx

# Netlify - Alternative deployment (Optional)
NETLIFY_TOKEN=xxx
NETLIFY_SITE_ID=xxx


# -----------------------------------------------------------------------------
# VERSION CONTROL
# -----------------------------------------------------------------------------
# GitHub - Git operations and OAuth
# Create app: https://github.com/settings/developers
GITHUB_TOKEN=ghp_xxx
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx

# GitHub App (for advanced features)
GITHUB_APP_ID=xxx
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nxxx\n-----END RSA PRIVATE KEY-----


# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS
# -----------------------------------------------------------------------------
# Sentry - Error tracking and monitoring
# Get DSN: https://sentry.io/settings/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=xxx
SENTRY_ORG=codeforge
SENTRY_PROJECT=codeforge-ai

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-xxx

# PostHog - Product analytics (Alternative)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# -----------------------------------------------------------------------------
# CDN & EDGE
# -----------------------------------------------------------------------------
# Cloudflare - CDN and edge functions
# Get API token: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=xxx
CLOUDFLARE_ZONE_ID=xxx
CLOUDFLARE_ACCOUNT_ID=xxx


# -----------------------------------------------------------------------------
# WEBHOOKS & INTEGRATIONS
# -----------------------------------------------------------------------------
# Webhook endpoints
WEBHOOK_SECRET=whsec_xxx

# Slack notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_BOT_TOKEN=xoxb-xxx

# Discord notifications (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx


# -----------------------------------------------------------------------------
# CACHING & QUEUE
# -----------------------------------------------------------------------------
# Redis - Caching and session storage
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=xxx

# Upstash Redis - Serverless Redis (Alternative)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx


# -----------------------------------------------------------------------------
# SEARCH & VECTOR DB
# -----------------------------------------------------------------------------
# Pinecone - Vector database for AI embeddings
PINECONE_API_KEY=xxx
PINECONE_ENVIRONMENT=xxx
PINECONE_INDEX=codeforge

# Algolia - Full-text search (Alternative)
ALGOLIA_APP_ID=xxx
ALGOLIA_ADMIN_API_KEY=xxx
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=xxx


# -----------------------------------------------------------------------------
# REAL-TIME & WEBSOCKETS
# -----------------------------------------------------------------------------
# Pusher - Real-time collaboration
# Get credentials: https://dashboard.pusher.com/
NEXT_PUBLIC_PUSHER_APP_KEY=xxx
PUSHER_APP_ID=xxx
PUSHER_SECRET=xxx
PUSHER_CLUSTER=us2

# Ably - Real-time messaging (Alternative)
NEXT_PUBLIC_ABLY_KEY=xxx


# -----------------------------------------------------------------------------
# AI ADDITIONAL SERVICES
# -----------------------------------------------------------------------------
# Replicate - AI model hosting
REPLICATE_API_TOKEN=r8_xxx

# Hugging Face - AI models
HUGGINGFACE_API_KEY=hf_xxx

# Cohere - NLP and embeddings
COHERE_API_KEY=xxx


# -----------------------------------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------------------------------
# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Environment
NODE_ENV=development

# Debug flags
DEBUG=false
VERBOSE_LOGGING=false


# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Encryption keys
ENCRYPTION_KEY=xxx
JWT_SECRET=xxx

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# CORS
CORS_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable/disable features
FEATURE_COLLABORATION=true
FEATURE_AI_SUGGESTIONS=true
FEATURE_GIT_INTEGRATION=true
FEATURE_DEPLOYMENT=true
FEATURE_SHARING=true


# =============================================================================
# PRIORITY SETUP GUIDE:
# =============================================================================
#
# ESSENTIAL (Set these first to run the app):
# 1. ANTHROPIC_API_KEY - For AI code generation
# 2. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY & CLERK_SECRET_KEY - For auth
# 3. NEXT_PUBLIC_SUPABASE_URL & keys - For database
#
# RECOMMENDED (Set these for full features):
# 4. STRIPE_SECRET_KEY - For payments
# 5. VERCEL_TOKEN - For deployments
# 6. GITHUB_TOKEN - For git operations
# 7. RESEND_API_KEY - For emails
#
# OPTIONAL (Nice to have):
# 8. SENTRY_DSN - Error tracking
# 9. NEXT_PUBLIC_GA_MEASUREMENT_ID - Analytics
# 10. AWS credentials - File storage
#
# =============================================================================
